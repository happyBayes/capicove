{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capicove.dev/schemas/agent-multimodal-trace/v1",
  "title": "Capicove Agent Multimodal Trace Record Version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "record_version",
    "record_id",
    "episode_id",
    "trace_id",
    "sequence",
    "occurred_at",
    "payload",
    "modalities",
    "step_id",
    "request_id",
    "parent_record_id",
    "media",
    "lineage",
    "warnings",
    "error",
    "privacy_class",
    "previous_record_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {
      "enum": [
        "episode.started",
        "message.observed",
        "tool.call",
        "tool.result",
        "artifact.produced",
        "batch.item",
        "episode.feedback",
        "episode.completed"
      ]
    },
    "record_version": {"const": 1},
    "record_id": {"$ref": "#/$defs/nonBlank"},
    "episode_id": {"$ref": "#/$defs/nonBlank"},
    "trace_id": {"$ref": "#/$defs/nonBlank"},
    "sequence": {"type": "integer", "minimum": 0},
    "occurred_at": {"$ref": "#/$defs/utcTimestamp"},
    "payload": {"type": "object"},
    "modalities": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/modality"}
    },
    "step_id": {"$ref": "#/$defs/nullableNonBlank"},
    "request_id": {"$ref": "#/$defs/nullableNonBlank"},
    "parent_record_id": {"$ref": "#/$defs/nullableNonBlank"},
    "media": {
      "type": "array",
      "items": {"$ref": "#/$defs/mediaReference"}
    },
    "lineage": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/traceLineage"}]
    },
    "warnings": {
      "type": "array",
      "items": {"$ref": "#/$defs/warning"}
    },
    "error": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/error"}]
    },
    "privacy_class": {
      "enum": ["public", "internal", "confidential", "restricted"]
    },
    "previous_record_sha256": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"sequence": {"const": 0}}},
      "then": {"properties": {"previous_record_sha256": {"type": "null"}}},
      "else": {"properties": {"previous_record_sha256": {"$ref": "#/$defs/sha256"}}}
    },
    {
      "oneOf": [
        {
          "properties": {
            "record_type": {"const": "episode.started"},
            "payload": {"$ref": "#/$defs/episodeStarted"}
          }
        },
        {
          "properties": {
            "record_type": {"const": "message.observed"},
            "payload": {"$ref": "#/$defs/messageObserved"}
          }
        },
        {
          "properties": {
            "record_type": {"const": "tool.call"},
            "request_id": {"$ref": "#/$defs/nonBlank"},
            "payload": {"$ref": "#/$defs/toolCall"}
          }
        },
        {
          "properties": {
            "record_type": {"const": "tool.result"},
            "request_id": {"$ref": "#/$defs/nonBlank"},
            "payload": {"$ref": "#/$defs/toolResult"}
          },
          "oneOf": [
            {
              "properties": {
                "payload": {"properties": {"status": {"const": "succeeded"}}},
                "error": {"type": "null"}
              }
            },
            {
              "properties": {
                "payload": {"properties": {"status": {"enum": ["failed", "rejected"]}}},
                "error": {"$ref": "#/$defs/error"}
              }
            }
          ]
        },
        {
          "properties": {
            "record_type": {"const": "artifact.produced"},
            "payload": {"$ref": "#/$defs/artifactProduced"}
          }
        },
        {
          "properties": {
            "record_type": {"const": "batch.item"},
            "payload": {"$ref": "#/$defs/batchItem"}
          }
        },
        {
          "properties": {
            "record_type": {"const": "episode.feedback"},
            "payload": {"$ref": "#/$defs/episodeFeedback"}
          }
        },
        {
          "properties": {
            "record_type": {"const": "episode.completed"},
            "payload": {"$ref": "#/$defs/episodeCompleted"}
          }
        }
      ]
    }
  ],
  "$defs": {
    "nonBlank": {"type": "string", "pattern": "\\S"},
    "nullableNonBlank": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/nonBlank"}]
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "modality": {"enum": ["audio", "image", "video"]},
    "jsonValue": {
      "oneOf": [
        {"type": "null"},
        {"type": "boolean"},
        {"type": "integer"},
        {"type": "number"},
        {"type": "string"},
        {"type": "array", "items": {"$ref": "#/$defs/jsonValue"}},
        {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/jsonValue"}
        }
      ]
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {"enum": ["artifact", "workspace_relative", "bundle"]},
        "value": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+"
        }
      }
    },
    "mediaReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "media_id",
        "modality",
        "media_type",
        "sha256",
        "size_bytes",
        "evidence_ref",
        "locator",
        "start_seconds",
        "end_seconds",
        "frame_indices",
        "derived_from"
      ],
      "properties": {
        "media_id": {"$ref": "#/$defs/nonBlank"},
        "modality": {"$ref": "#/$defs/modality"},
        "media_type": {"$ref": "#/$defs/nonBlank"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "evidence_ref": {"$ref": "#/$defs/nullableNonBlank"},
        "locator": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/locator"}]
        },
        "start_seconds": {"type": ["number", "null"], "minimum": 0},
        "end_seconds": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "frame_indices": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0}
        },
        "derived_from": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonBlank"}
        }
      }
    },
    "traceLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["values"],
      "properties": {
        "values": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/jsonValue"}
        }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"$ref": "#/$defs/nonBlank"},
        "message": {"$ref": "#/$defs/nonBlank"}
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {"$ref": "#/$defs/nonBlank"},
        "message": {"$ref": "#/$defs/nonBlank"},
        "retryable": {"type": "boolean"}
      }
    },
    "agentLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "availability",
        "agent_id",
        "agent_version",
        "model_id",
        "model_revision",
        "generation_parameters_sha256",
        "prompt_template_sha256"
      ],
      "properties": {
        "availability": {"enum": ["captured", "not_observed", "redacted"]},
        "agent_id": {"$ref": "#/$defs/nullableNonBlank"},
        "agent_version": {"$ref": "#/$defs/nullableNonBlank"},
        "model_id": {"$ref": "#/$defs/nullableNonBlank"},
        "model_revision": {"$ref": "#/$defs/nullableNonBlank"},
        "generation_parameters_sha256": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]
        },
        "prompt_template_sha256": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]
        }
      }
    },
    "episodeStarted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goal",
        "workspace_id",
        "actor_id",
        "environment_id",
        "environment_version",
        "tool_catalog_sha256",
        "active_asset_versions",
        "agent_lineage"
      ],
      "properties": {
        "goal": {"$ref": "#/$defs/nonBlank"},
        "workspace_id": {"$ref": "#/$defs/nonBlank"},
        "actor_id": {"$ref": "#/$defs/nonBlank"},
        "environment_id": {"$ref": "#/$defs/nonBlank"},
        "environment_version": {"type": "integer", "minimum": 1},
        "tool_catalog_sha256": {"$ref": "#/$defs/sha256"},
        "active_asset_versions": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 1}
        },
        "agent_lineage": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/agentLineage"}]
        }
      }
    },
    "textContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text"],
      "properties": {"type": {"const": "text"}, "text": {"type": "string"}}
    },
    "mediaContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "media_id"],
      "properties": {
        "type": {"const": "media"},
        "media_id": {"$ref": "#/$defs/nonBlank"}
      }
    },
    "messageObserved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "content"],
      "properties": {
        "role": {"enum": ["system", "user", "assistant"]},
        "content": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {"$ref": "#/$defs/textContent"},
              {"$ref": "#/$defs/mediaContent"}
            ]
          }
        }
      }
    },
    "toolCall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_id",
        "tool_version",
        "arguments",
        "arguments_schema_sha256",
        "attempt"
      ],
      "properties": {
        "tool_id": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$"},
        "tool_version": {"type": "integer", "minimum": 1},
        "arguments": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/jsonValue"}
        },
        "arguments_schema_sha256": {"$ref": "#/$defs/sha256"},
        "attempt": {"type": "integer", "minimum": 1}
      }
    },
    "toolResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_id",
        "tool_version",
        "status",
        "result_schema_sha256",
        "result",
        "evidence_refs",
        "metrics"
      ],
      "properties": {
        "tool_id": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$"},
        "tool_version": {"type": "integer", "minimum": 1},
        "status": {"enum": ["succeeded", "failed", "rejected"]},
        "result_schema_sha256": {"$ref": "#/$defs/sha256"},
        "result": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": {"$ref": "#/$defs/jsonValue"}
            }
          ]
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonBlank"}
        },
        "metrics": {"type": "object", "additionalProperties": {"type": "number"}}
      }
    },
    "artifactProduced": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_ref", "media_id", "derived_from"],
      "properties": {
        "artifact_ref": {"$ref": "#/$defs/nonBlank"},
        "media_id": {"$ref": "#/$defs/nonBlank"},
        "derived_from": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonBlank"}
        }
      }
    },
    "batchItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_id",
        "item_id",
        "state",
        "attempts",
        "cache_hit",
        "modality",
        "media_type",
        "size_bytes",
        "source_sha256",
        "cache_key",
        "detail"
      ],
      "properties": {
        "plan_id": {"type": "string", "pattern": "^plan:[0-9a-f]{64}$"},
        "item_id": {"type": "string", "pattern": "^item:[0-9a-f]{64}$"},
        "state": {"enum": ["succeeded", "failed", "skipped", "source_changed"]},
        "attempts": {"type": "integer", "minimum": 0},
        "cache_hit": {"type": "boolean"},
        "modality": {"$ref": "#/$defs/modality"},
        "media_type": {"$ref": "#/$defs/nonBlank"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "cache_key": {"type": "string", "pattern": "^cache:[0-9a-f]{64}$"},
        "detail": {"$ref": "#/$defs/nullableNonBlank"}
      }
    },
    "episodeFeedback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value", "provenance", "target_record_id"],
      "properties": {
        "kind": {"$ref": "#/$defs/nonBlank"},
        "value": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/jsonValue"}
        },
        "provenance": {"$ref": "#/$defs/nonBlank"},
        "target_record_id": {"$ref": "#/$defs/nullableNonBlank"}
      }
    },
    "episodeCompleted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "outcome"],
      "properties": {
        "status": {"enum": ["succeeded", "failed", "rejected", "incomplete"]},
        "outcome": {"$ref": "#/$defs/nullableNonBlank"}
      }
    }
  }
}
